{
  "name": "slidev-theme-yasio-dev",
  "version": "0.0.2",
  "description": "Theme for Slidev",
  "author": "Yasio <hello@yasiodev>",
  "keywords": [
    "slidev-theme",
    "slidev-theme-yasio-dev",
    "yasio-dev",
    "yasio",
    "slidev"
  ],
  "license": "MIT",
  "files": [
    "components",
    "layouts",
    "public",
    "setup",
    "styles",
    "example.md",
    "README.md"
  ],
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "codemirror-theme-vars": "^0.1.1",
    "prism-theme-vars": "^0.2.2",
    "theme-vitesse": "^0.1.14"
  },
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=53.0.0"
  },
  "peerDependencies": {
    "@slidev/client": "^53.0.0",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@slidev/cli": "53.0.0",
    "@slidev/client": "53.0.0",
    "@slidev/types": "53.0.0",
    "playwright-chromium": "^1.20.2",
    "sass": "^1.104.1",
    "vue": "^3.5.33"
  },
  "homepage": "https://yasio.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YasiOnFire/slidev-theme-yasio-dev.git"
  },
  "slidev": {
    "colorSchema": "dark",
    "highlighter": "shiki",
    "defaults": {
      "aspectRatio": "16/9",
      "fonts": {
        "provider": "none",
        "sans": "Noto Sans",
        "serif": "Noto Sans",
        "mono": "Consolas ligaturized v2",
        "local": ["Noto Sans", "IBM Plex Sans", "Source Sans 3", "Manrope", "Inter", "Consolas ligaturized v2", "Consolas"]
      }
    }
  },
  "bugs": "https://github.com/YasiOnFire/slidev-theme-yasio-dev/issues",
  "release": {
    "branches": [
      "master"
    ]
  }
}
